<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <layer-list>
            <!-- tranche sombre du dessous : c'est elle qui donne le biseau -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gold_edge" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="@color/gold_lit"
                        android:endColor="@color/gold" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="@color/gold_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
