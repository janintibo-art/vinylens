<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- lumière douce venant du haut, comme une lampe au-dessus du bac à disques -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.18"
                android:gradientRadius="140%p"
                android:startColor="@color/paper_lit"
                android:endColor="@color/paper_shade" />
        </shape>
    </item>
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="start|top"
        android:start="-150dp"
        android:top="60dp"
        android:drawable="@drawable/ic_grooves" />
    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="end|bottom"
        android:end="-140dp"
        android:bottom="40dp"
        android:drawable="@drawable/ic_grooves" />
    <item>
        <bitmap
            android:src="@drawable/paper_grain"
            android:tileModeX="repeat"
            android:tileModeY="repeat" />
    </item>
</layer-list>
