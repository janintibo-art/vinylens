<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/slot_top"
                android:endColor="@color/slot_bottom" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- liseré clair en haut : simule la lumière qui accroche le bord -->
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/edge_light" />
        </shape>
    </item>
</layer-list>
